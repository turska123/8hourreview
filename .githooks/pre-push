#!/usr/bin/env bash
# Clean gate before every push (standard §4). Turn on once per clone:
#   git config core.hooksPath .githooks
# Passes at once if tools/check.sh already printed ALL CLEAN on the exact commit being pushed (.git/check-stamp).
# Otherwise runs the check now. A person can skip it in an emergency with --no-verify; Claude can't (guard hook).
# wip/<issue>-<name> branches get the secret scan only (gitleaks, every commit the push would send), so unfinished
# work that fails the check still reaches the forge (/handoff, dev-wiki#38). Merging still needs ALL CLEAN.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
stamp="$(git rev-parse --git-dir)/check-stamp"
zero="0000000000000000000000000000000000000000"
head="$(git rev-parse HEAD)"
wip_ref='^refs/heads/wip/[0-9]+-.+'
need_check=0
wip_commits=()

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a remote branch: nothing to check
  # Annotated tags point at a tag object: compare the commit behind it.
  local_commit="$(git rev-parse "$local_sha^{commit}")"
  if [[ "$remote_ref" =~ $wip_ref ]]; then wip_commits+=("$local_commit"); continue; fi
  [[ -f "$stamp" && "$(cat "$stamp")" == "$local_commit" ]] && continue
  if [[ "$local_commit" != "$head" ]]; then
    echo "pre-push: $local_commit isn't checked out, so the check can't run on it."
    echo "          Check it out, run tools/check.sh, then push again."
    exit 1
  fi
  need_check=1
done

for commit in "${wip_commits[@]}"; do
  if ! command -v gitleaks > /dev/null 2>&1; then
    echo "pre-push: gitleaks is missing, so a wip/ push can't be scanned (install: sudo dnf install gitleaks)."
    exit 1
  fi
  # Everything reachable from the pushed commit: simple, and it can't miss a commit the forge doesn't have yet.
  # --redact: the report shows file:line and rule, never the secret.
  echo "pre-push: wip/ branch, secret scan only (gitleaks) ..."
  (cd "$root" && gitleaks git --redact --no-banner --log-opts="$commit" .) ||
    { echo "pre-push: possible secret in the commits, push refused. Remove it (rotate it if it was real)."; exit 1; }
done

[[ $need_check -eq 0 ]] && exit 0

if [[ -n "$(git status --porcelain)" ]]; then
  echo "pre-push: uncommitted changes. The check runs on the working tree, so it wouldn't be testing what you push."
  echo "          Commit or stash them, then push again."
  exit 1
fi

echo "pre-push: running tools/check.sh ..."
# git exports GIT_DIR (from a worktree also GIT_PREFIX ...) to hooks. The check runs tests that make throwaway
# repos: with these set, their git would write into this repo (house-rules #20). The check finds the repo from
# its own folder instead.
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY \
  GIT_DIR GIT_WORK_TREE GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE GIT_INDEX_FILE GIT_NO_REPLACE_OBJECTS \
  GIT_REPLACE_REF_BASE GIT_PREFIX GIT_SHALLOW_FILE GIT_COMMON_DIR GIT_CEILING_DIRECTORIES GIT_NAMESPACE \
  GIT_DISCOVERY_ACROSS_FILESYSTEM
for var in $(compgen -e | grep -E '^GIT_CONFIG_(KEY|VALUE)_[0-9]+$'); do unset "$var"; done
cd "$root" || exit 1
"$root/tools/check.sh" || { echo "pre-push: check failed, push refused. Fix the cause and push again."; exit 1; }
